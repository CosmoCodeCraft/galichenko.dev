---
import Header from "../components/Header.astro";
import { site } from "../config/site";
import { route, t, type Locale } from "../i18n";
import { PERSON_ID, type StructuredData } from "../utils/structured-data";
import { absoluteSiteUrl } from "../utils/urls";
import "../styles/global.css";
interface Props {
  locale: Locale;
  title: string;
  home?: boolean;
  description?: string;
  noindex?: boolean;
  alternates?: { locale: Locale; url: string }[];
  structuredData?: StructuredData;
}
const {
  locale,
  title,
  home = false,
  description = title,
  noindex = false,
  alternates = [],
  structuredData,
} = Astro.props;
const d = t(locale);
const mainClass = home ? "home-main" : "wrap";
const criticalFontSubset = locale === "ru" ? "Cyrillic" : "Latin1";
const canonical = absoluteSiteUrl(Astro.url.pathname);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": PERSON_ID,
  name: site.name,
  ...site.person,
  url: site.url,
  email: site.email,
  sameAs: [site.github],
};
---

<!doctype html>
<html lang={locale}>
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><title>{title}</title><meta
      name="description"
      content={description}
    /><link rel="canonical" href={canonical} /><meta
      property="og:title"
      content={title}
    /><meta property="og:description" content={description} /><meta
      property="og:type"
      content="website"
    /><meta property="og:url" content={canonical} /><meta
      property="og:locale"
      content={locale === "en" ? "en_US" : "ru_RU"}
    /><meta name="color-scheme" content="light dark" />{
      noindex && <meta name="robots" content="noindex,follow" />
    }{
      alternates.map((a) => (
        <link
          rel="alternate"
          hreflang={a.locale}
          href={absoluteSiteUrl(a.url)}
        />
      ))
    }<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const p = localStorage.getItem("sg-theme");
        if (p === "light" || p === "dark")
          document.documentElement.dataset.theme = p;
      } catch {
        /* Storage may be unavailable. */
      }
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(person).replace(/</g, "\u003c")}
    />{
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, "\u003c")}
        />
      )
    }<link
      rel="preload"
      href={`/fonts/ibm-plex/IBMPlexSans-Regular-${criticalFontSubset}.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    /></head
  ><body id="top"
    ><Header locale={locale} /><main id="main" class={mainClass} tabindex="-1">
      <slot />
    </main><footer>
      <div class="wrap footer-inner">
        <div class="footer-identity">
          <strong>{site.name}</strong><span>{d.footerRole}</span>
        </div><nav class="footer-links" aria-label={d.nav}>
          <a href={site.github} target="_blank" rel="noopener noreferrer"
            >{d.github}</a
          ><a href={`mailto:${site.email}`}>{d.email}</a><a
            href={route(locale, "cv")}>{d.cv}</a
          ><a href="#top" class="footer-back-desktop"
            >{d.backTop} <span aria-hidden="true">↑</span></a
          >
        </nav><div class="footer-closing">
          <span class="footer-copyright">© {new Date().getFullYear()}</span><a
            class="footer-back-mobile"
            href="#top">{d.backTop} <span aria-hidden="true">↑</span></a
          >
        </div>
      </div>
    </footer><script src="../utils/interactions.ts"></script><!-- Cloudflare Web Analytics -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "2f18cdf70ebb4d8799e7d5bf4f56ade6"}'
    ></script><!-- End Cloudflare Web Analytics --></body
  >
</html>
