---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Home from "../components/Home.astro";
import ProjectsIndex from "../components/collection/ProjectsIndex.astro";
import ResearchIndex from "../components/collection/ResearchIndex.astro";
import NotesIndex from "../components/collection/NotesIndex.astro";
import ProjectDetail from "../components/project/ProjectDetail.astro";
import PublicationDetail from "../components/publication/PublicationDetail.astro";
import NoteDetail from "../components/note/NoteDetail.astro";
import AboutPage from "../components/about/AboutPage.astro";
import CvPage from "../components/cv/CvPage.astro";
import { enabledLocales, route, t, type Locale } from "../i18n";
import { navigation, site } from "../config/site";
import { homeCopy } from "../config/home";
import { aboutContent } from "../content/about";
import { cvContent } from "../content/cv";
import { entries, entryPath, type Entry } from "../utils/content";
import { structuredDataForEntry } from "../utils/structured-data";
import { absoluteSiteUrl } from "../utils/urls";
export const getStaticPaths = (async () => {
  const all = await entries();
  return [
    ...enabledLocales.flatMap((locale) => [
      {
        params: { path: route(locale).slice(1) || undefined },
        props: { locale, kind: "home" },
      },
      ...navigation.map((kind) => ({
        params: { path: route(locale, kind).slice(1) },
        props: { locale, kind },
      })),
    ]),
    ...all.map((entry) => ({
      params: { path: entryPath(entry).slice(1) },
      props: { locale: entry.data.locale, kind: "detail", entry },
    })),
  ];
}) satisfies GetStaticPaths;
interface Props {
  locale: Locale;
  kind: string;
  entry?: Entry;
}
const { locale, kind, entry } = Astro.props;
const d = t(locale);
const all = await entries();
const isHome = kind === "home";
const isCollectionIndex =
  !entry && (kind === "projects" || kind === "research" || kind === "notes");
const isAbout = !entry && kind === "about";
const isCv = !entry && kind === "cv";
const isPublication = entry?.collection === "publications";
const isProject = entry?.collection === "projects";
const isNote = entry?.collection === "notes";
const collectionDescriptions = {
  projects: d.projectsMetaDescription,
  research: d.researchMetaDescription,
  notes: d.notesMetaDescription,
};
const title = isHome
  ? site.name
  : entry
    ? "titleOriginal" in entry.data
      ? entry.data.titleOriginal
      : entry.data.title
    : d[kind as keyof typeof d];
const description = isHome
  ? homeCopy[locale]?.intro
  : isAbout
    ? aboutContent[locale]?.metaDescription
    : isCv
      ? cvContent[locale]?.metaDescription
      : isCollectionIndex
        ? collectionDescriptions[kind as keyof typeof collectionDescriptions]
        : isPublication
          ? (entry.data.abstractEnglish ??
            entry.data.titleEnglish ??
            entry.data.titleOriginal)
          : entry && "summary" in entry.data
            ? entry.data.summary
            : title;
const alternates = entry
  ? all
      .filter(
        (e) =>
          e.collection === entry.collection &&
          e.data.translationKey === entry.data.translationKey,
      )
      .map((e) => ({ locale: e.data.locale, url: entryPath(e) }))
  : enabledLocales.map((l) => ({
      locale: l,
      url: route(l, isHome ? "" : kind),
    }));
const pageTitle = isCv
  ? cvContent[locale]?.metaTitle
  : isHome
    ? `${site.name} — DevOps & Systems Integration Engineer`
    : `${title} — ${site.name}`;
const structuredData = entry
  ? structuredDataForEntry(entry, absoluteSiteUrl(Astro.url.pathname))
  : undefined;
---

<BaseLayout
  locale={locale}
  title={pageTitle ?? `${title} — ${site.name}`}
  home={isHome}
  description={description}
  noindex={!isHome &&
    !isCollectionIndex &&
    !isPublication &&
    !isProject &&
    !isNote &&
    !isAbout &&
    !isCv}
  alternates={alternates}
  structuredData={structuredData}
>
  {
    isHome ? (
      <Home locale={locale} />
    ) : kind === "projects" && !entry ? (
      <ProjectsIndex locale={locale} />
    ) : kind === "research" && !entry ? (
      <ResearchIndex locale={locale} />
    ) : kind === "notes" && !entry ? (
      <NotesIndex locale={locale} />
    ) : isAbout ? (
      <AboutPage locale={locale} />
    ) : isCv ? (
      <CvPage locale={locale} />
    ) : entry?.collection === "projects" ? (
      <ProjectDetail project={entry} locale={locale} />
    ) : entry?.collection === "publications" ? (
      <PublicationDetail publication={entry} locale={locale} />
    ) : entry?.collection === "notes" ? (
      <NoteDetail note={entry} locale={locale} />
    ) : (
      <article class="skeleton">
        <p class="label">{d.home}</p>
        <h1 lang={locale}>{title}</h1>
        <p class="notice">{d.placeholder}</p>
        <a class="text-link" href={route(locale)}>
          {d.backHome}
        </a>
      </article>
    )
  }
</BaseLayout>
