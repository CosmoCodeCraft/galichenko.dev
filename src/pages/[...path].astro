---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Home from "../components/Home.astro";
import ProjectsIndex from "../components/collection/ProjectsIndex.astro";
import ResearchIndex from "../components/collection/ResearchIndex.astro";
import NotesIndex from "../components/collection/NotesIndex.astro";
import ProjectDetail from "../components/project/ProjectDetail.astro";
import PublicationDetail from "../components/publication/PublicationDetail.astro";
import { enabledLocales, route, t, type Locale } from "../i18n";
import { navigation, site } from "../config/site";
import { homeCopy } from "../config/home";
import { entries, entryPath, type Entry } from "../utils/content";
export const getStaticPaths = (async () => {
  const all = await entries();
  return [
    ...enabledLocales.flatMap((locale) => [
      {
        params: { path: route(locale).slice(1) || undefined },
        props: { locale, kind: "home" },
      },
      ...navigation.map((kind) => ({
        params: { path: route(locale, kind).slice(1) },
        props: { locale, kind },
      })),
    ]),
    ...all.map((entry) => ({
      params: { path: entryPath(entry).slice(1) },
      props: { locale: entry.data.locale, kind: "detail", entry },
    })),
  ];
}) satisfies GetStaticPaths;
interface Props {
  locale: Locale;
  kind: string;
  entry?: Entry;
}
const { locale, kind, entry } = Astro.props;
const d = t(locale);
const all = await entries();
const isHome = kind === "home";
const isCollectionIndex =
  !entry && (kind === "projects" || kind === "research" || kind === "notes");
const isPublication = entry?.collection === "publications";
const isProject = entry?.collection === "projects";
const title = isHome
  ? site.name
  : entry
    ? "titleOriginal" in entry.data
      ? entry.data.titleOriginal
      : entry.data.title
    : d[kind as keyof typeof d];
const description = isHome
  ? homeCopy[locale]?.intro
  : isPublication
    ? (entry.data.abstractEnglish ??
      entry.data.titleEnglish ??
      entry.data.titleOriginal)
    : entry && "summary" in entry.data
      ? entry.data.summary
      : title;
const alternates = entry
  ? all
      .filter(
        (e) =>
          e.collection === entry.collection &&
          e.data.translationKey === entry.data.translationKey,
      )
      .map((e) => ({ locale: e.data.locale, url: entryPath(e) }))
  : enabledLocales.map((l) => ({
      locale: l,
      url: route(l, isHome ? "" : kind),
    }));
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<BaseLayout
  locale={locale}
  title={isHome
    ? `${site.name} — DevOps & Systems Integration Engineer`
    : `${title} — ${site.name}`}
  description={description}
  noindex={!isHome && !isCollectionIndex && !isPublication && !isProject}
  alternates={alternates}
>
  {
    isHome ? (
      <Home locale={locale} />
    ) : kind === "projects" && !entry ? (
      <ProjectsIndex locale={locale} />
    ) : kind === "research" && !entry ? (
      <ResearchIndex locale={locale} />
    ) : kind === "notes" && !entry ? (
      <NotesIndex locale={locale} />
    ) : entry?.collection === "projects" ? (
      <ProjectDetail project={entry} locale={locale} />
    ) : entry?.collection === "publications" ? (
      <PublicationDetail publication={entry} locale={locale} />
    ) : (
      <article class="skeleton">
        <>
          <p class="label">{entry ? d[entry.collection] : d.home}</p>
          <h1 lang={locale}>{title}</h1>
          <p class="notice">{entry ? d.detailPlaceholder : d.placeholder}</p>
        </>
        {entry && (
          <>
            {"summary" in entry.data && <p>{entry.data.summary}</p>}
            {Content && (
              <div class="prose">
                <Content />
              </div>
            )}
          </>
        )}
        <a class="text-link" href={route(locale)}>
          {d.backHome}
        </a>
      </article>
    )
  }
</BaseLayout>
