---
import type { CollectionEntry } from "astro:content";
import { entryPath } from "../utils/content";
import { authorName, isSergey } from "../utils/publications";
interface Props {
  publication: CollectionEntry<"publications">;
}
const { publication } = Astro.props;
const p = publication.data;
---

<a
  class="publication-row"
  href={entryPath(publication)}
  aria-labelledby={`paper-${p.id}`}
  ><span class="year">{p.year}</span><div>
    <h3 id={`paper-${p.id}`} lang={p.languageOriginal}>{p.titleOriginal}</h3>{
      p.titleEnglish && p.languageOriginal !== "en" && (
        <p class="summary" lang="en">
          {p.titleEnglish}
        </p>
      )
    }<p class="authors" lang={p.languageOriginal}>
      {
        p.authorsOriginal.map((author, i) => (
          <>
            {i > 0 ? ", " : ""}
            {isSergey(author) ? (
              <strong>{authorName(author)}</strong>
            ) : (
              authorName(author)
            )}
          </>
        ))
      }
    </p>
  </div><span class="arrow" aria-hidden="true">→</span></a
>
