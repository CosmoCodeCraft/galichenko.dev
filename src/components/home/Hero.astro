---
import { homeCopy } from "../../config/home";
import { site } from "../../config/site";
import { t, type Locale } from "../../i18n";
import HeroSystemVisual from "./HeroSystemVisual.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = homeCopy[locale];
if (!copy) throw new Error(`Missing home copy: ${locale}`);
const d = t(locale);
---

<section class="hero wrap">
  <div class="hero-copy">
    <h1>
      {site.name.split(" ")[0]}<br />{site.name.split(" ")[1]}<span
        class="accent">.</span
      >
    </h1><p class="role">{copy.role}</p><p class="specialty">
      {copy.specialty}
    </p><p class="intro">{copy.intro}</p>
  </div><div class="hero-visual" aria-hidden="true">
    <HeroSystemVisual />
  </div><a class="scroll-hint" href="#projects"
    >{d.selectedWork} <span aria-hidden="true">↓</span></a
  >
</section>
