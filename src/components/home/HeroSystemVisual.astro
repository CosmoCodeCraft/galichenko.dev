    <linearGradient id="hero-system-tail" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--hero-system-active)" stop-opacity="0"
      ></stop>
      <stop
        offset="0.72"
        stop-color="var(--hero-system-active)"
        stop-opacity="0.34"></stop>
      <stop
        offset="1"
        stop-color="var(--hero-system-active)"
        stop-opacity="0.92"></stop>
    </linearGradient>
    <linearGradient id="hero-system-tail-warn" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--hero-system-warn)" stop-opacity="0"
      ></stop>
      <stop
        offset="0.72"
        stop-color="var(--hero-system-warn)"
        stop-opacity="0.3"></stop>
      <stop offset="1" stop-color="var(--hero-system-warn)" stop-opacity="0.88"
      ></stop>
    </linearGradient>
    <filter
      id="hero-system-soft-glow"
      x="-80%"
      y="-180%"
      width="260%"
      height="460%"
