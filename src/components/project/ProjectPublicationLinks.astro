---
import { getCollection } from "astro:content";
import { t, type Locale } from "../../i18n";
import { entryPath } from "../../utils/content";

interface Props {
  ids: string[];
  locale: Locale;
}

const { ids, locale } = Astro.props;
const d = t(locale);
const publications = (await getCollection("publications"))
  .filter(
    (publication) =>
      ids.includes(publication.data.id) &&
      publication.data.locale === locale &&
      !publication.data.draft,
  )
  .sort((a, b) => ids.indexOf(a.data.id) - ids.indexOf(b.data.id));
---

{
  publications.length > 0 && (
    <div class="project-publications">
      <h3>{d.relatedPublications}</h3>
      <ul>
        {publications.map((publication) => (
          <li>
            <a href={entryPath(publication)}>
              {publication.data.titleOriginal}
            </a>
            <span>{d[publication.data.status]}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}
