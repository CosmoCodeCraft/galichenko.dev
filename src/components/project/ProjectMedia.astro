---
import type { ImageMetadata } from "astro";
import Figure from "../Figure.astro";

interface Props {
  type?: "image" | "video" | "placeholder";
  src?: ImageMetadata | string;
  poster?: ImageMetadata;
  alt?: string;
  caption?: string;
  label?: string;
  placeholder?: string;
  role?: "hero" | "content" | "diagram" | "result" | "hardware";
  cropAllowed?: boolean;
  focalPoint?: { x: number; y: number };
  ratio?: "16:9" | "3:2" | "wide";
  wide?: boolean;
  loading?: "lazy" | "eager";
}

const {
  type,
  src,
  poster,
  alt = "",
  caption,
  label,
  placeholder,
  role = "content",
  cropAllowed = false,
  focalPoint,
  ratio = "16:9",
  wide = false,
  loading = "lazy",
} = Astro.props;
const isVideo = type === "video";
const imageSource = !isVideo && typeof src !== "string" ? src : undefined;
const videoSource = isVideo && typeof src === "string" ? src : undefined;
const placeholderLabel = placeholder ?? label;
---

{
  isVideo && videoSource && poster ? (
    <figure
      class:list={[
        "project-media",
        "project-media-video",
        { "project-media--wide": wide },
      ]}
      data-role={role}
    >
      <div class="project-video-frame">
        <video
          src={videoSource}
          poster={poster.src}
          aria-label={alt}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          data-project-video
        />
        <img
          class="project-video-poster"
          src={poster.src}
          width={poster.width}
          height={poster.height}
          alt=""
          aria-hidden="true"
          loading={loading}
          decoding="async"
        />
      </div>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  ) : imageSource ? (
    <div class:list={["project-media", { "project-media--wide": wide }]}>
      <Figure
        src={imageSource}
        alt={alt}
        caption={caption}
        role={role}
        cropAllowed={cropAllowed}
        focalPoint={focalPoint}
        sizes="(max-width: 42rem) calc(100vw - 44px), 1000px"
        loading={loading}
      />
    </div>
  ) : (
    <figure
      class:list={[
        "project-media",
        "project-media-placeholder",
        `project-media-ratio-${ratio.replace(":", "-")}`,
        { "project-media--wide": wide },
      ]}
      data-role={role}
    >
      <div aria-hidden="true">
        <span>{placeholderLabel}</span>
      </div>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function syncProjectVideos() {
    document
      .querySelectorAll<HTMLVideoElement>("[data-project-video]")
      .forEach((video) => {
        if (reducedMotion.matches) {
          video.pause();
          video.currentTime = 0;
          return;
        }

        video.muted = true;
        void video.play().catch(() => {
          // The poster remains visible when autoplay is unavailable.
        });
      });
  }

  syncProjectVideos();
  reducedMotion.addEventListener("change", syncProjectVideos);
</script>
