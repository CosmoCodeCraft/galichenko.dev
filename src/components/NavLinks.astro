---
import { navigation, site } from "../config/site";
import { route, t, type Locale } from "../i18n";
import NavIcon from "./NavIcon.astro";
import ThemeControl from "./ThemeControl.astro";
interface Props {
  locale: Locale;
  group?: "primary" | "actions" | "all";
}
const { locale, group = "all" } = Astro.props;
const d = t(locale);
---

{
  group !== "actions" && (
    <div class="primary-links">
      {navigation.map((key) => (
        <a
          href={route(locale, key)}
          aria-current={
            Astro.url.pathname.replace(/\/$/, "") === route(locale, key)
              ? "page"
              : undefined
          }
        >
          {d[key]}
        </a>
      ))}
    </div>
  )
}
{
  group !== "primary" && (
    <div class="nav-social">
      <a class="nav-action-link" href={site.github}>
        <NavIcon name="github" />
        <span>{d.github}</span>
      </a>
      <a class="nav-action-link" href={`mailto:${site.email}`}>
        <NavIcon name="email" />
        <span>{d.email}</span>
      </a>
      <ThemeControl locale={locale} />
    </div>
  )
}
