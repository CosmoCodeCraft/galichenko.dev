---
import { homeSections } from "../config/home";
import type { Locale } from "../i18n";
import Hero from "./home/Hero.astro";
import FeaturedProjects from "./home/FeaturedProjects.astro";
import ExperienceSignal from "./home/ExperienceSignal.astro";
import SelectedResearch from "./home/SelectedResearch.astro";
import Contact from "./home/Contact.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const registry = {
  hero: Hero,
  featuredProjects: FeaturedProjects,
  experienceSignal: ExperienceSignal,
  selectedResearch: SelectedResearch,
  contact: Contact,
};
---

{
  homeSections
    .filter((s) => s.enabled)
    .map((s) => {
      const Section = registry[s.id];
      return <Section locale={locale} />;
    })
}
