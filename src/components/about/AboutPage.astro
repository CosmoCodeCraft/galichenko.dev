---
import { aboutContent } from "../../content/about";
import { route, type Locale } from "../../i18n";
import { Image } from "astro:assets";
import portrait from "../../assets/about/portrait.webp";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = aboutContent[locale];
if (!content) throw new Error(`About content is missing for locale: ${locale}`);
---

<article class="about-page">
  <header class="about-introduction">
    <div class="about-introduction-copy">
      <h1>{content.title}</h1>
      <div class="about-lede">
        {content.introduction.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <figure class="about-portrait">
      <Image
        src={portrait}
        alt={content.portraitLabel}
        widths={[300, 600, 900, 1200]}
        sizes="(max-width: 42rem) 76vw, 300px"
        loading="eager"
        decoding="async"
      />
    </figure>
  </header>

  <section class="about-section" aria-labelledby="about-focus-heading">
    <h2 id="about-focus-heading">{content.focusHeading}</h2>
    <div class="about-focus">
      {
        content.focus.map((area) => (
          <article>
            <h3>{area.title}</h3>
            {area.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {area.scope && (
              <p class="about-focus-scope">{area.scope.join(" · ")}</p>
            )}
            {area.states?.map((state) => (
              <div class="about-focus-state">
                <h4>{state.label}</h4>
                <p>{state.description}</p>
                <ul>
                  {state.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))
      }
    </div>
  </section>

  <section class="about-section" aria-labelledby="about-experience-heading">
    <h2 id="about-experience-heading">{content.experienceHeading}</h2>
    <ol class="about-dated-list">
      {
        content.experience.map((experience) => (
          <li class="about-dated-row">
            <p class="about-date">{experience.period}</p>
            <div class="about-row-content">
              <h3>{experience.role}</h3>
              <p class="about-organisation">{experience.organization}</p>
              {experience.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {experience.link && (
                <a
                  class="about-inline-link"
                  href={route(locale, experience.link.path)}
                >
                  {experience.link.label}
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    class="about-section about-reading-section"
    aria-labelledby="about-trajectory-heading"
  >
    <h2 id="about-trajectory-heading">{content.trajectoryHeading}</h2>
    <div class="about-prose">
      {content.trajectory.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="about-section" aria-labelledby="about-education-heading">
    <h2 id="about-education-heading">{content.educationHeading}</h2>
    <div class="about-education-grid">
      {
        content.education.map((education) => (
          <article>
            <p class="about-date">{education.period}</p>
            <h3>{education.institution}</h3>
            <a class="about-programme-link" href={education.programmeUrl}>
              {education.programme}
            </a>
            {education.details.map((detail) => (
              <p>{detail}</p>
            ))}
            {education.note && <p class="about-note">{education.note}</p>}
          </article>
        ))
      }
    </div>
  </section>

  <section class="about-section" aria-labelledby="about-research-heading">
    <h2 id="about-research-heading">{content.researchHeading}</h2>
    <div class="about-research-layout">
      <div class="about-research-introduction about-prose">
        {content.researchIntroduction.map((paragraph) => <p>{paragraph}</p>)}
        <a class="about-inline-link" href={route(locale, "research")}>
          {content.researchLinkLabel}
        </a>
      </div>
      <article class="about-community">
        <h3>{content.community.role}</h3>
        <p class="about-organisation">{content.community.organization}</p>
        {content.community.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </article>
    </div>
  </section>

  <section class="about-section" aria-labelledby="about-recognition-heading">
    <h2 id="about-recognition-heading">{content.recognitionHeading}</h2>
    <ol class="about-recognition-grid">
      {
        content.recognition.map((item) => (
          <li>
            <p class="about-date">{item.year}</p>
            <h3>{item.title}</h3>
            <p class="about-distinction">{item.distinction}</p>
            <p>{item.context}</p>
            {item.evidence && (
              <a class="about-inline-link" href={item.evidence.url}>
                {item.evidence.label}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="about-section" aria-labelledby="about-mentions-heading">
    <h2 id="about-mentions-heading">{content.mentionsHeading}</h2>
    <ol class="about-mentions">
      {
        content.mentions.map((mention) => (
          <li>
            <p class="about-mention-meta">
              <time>{mention.date}</time>
              <span>{mention.source}</span>
            </p>
            <div>
              <h3 lang={mention.titleLanguage}>{mention.title}</h3>
              <p>{mention.context}</p>
              <a class="about-inline-link" href={mention.link.url}>
                {mention.link.label}
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="about-section" aria-labelledby="about-principles-heading">
    <h2 id="about-principles-heading">{content.principlesHeading}</h2>
    <div class="about-principles">
      {
        content.principles.map((principle) => (
          <article>
            <h3>{principle.title}</h3>
            {principle.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </article>
        ))
      }
    </div>
  </section>
</article>
