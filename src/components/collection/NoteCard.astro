---
import type { CollectionEntry } from "astro:content";
import { noteDateRange } from "../../i18n";
import { entryPath } from "../../utils/content";
import Figure from "../Figure.astro";
interface Props {
  note: CollectionEntry<"notes">;
}
const { note } = Astro.props;
const n = note.data;
const period = noteDateRange(n.date, n.endDate, n.locale);
---

<a class="note-card" href={entryPath(note)} aria-labelledby={`note-${n.id}`}>
  <div class="note-card-media">
    {
      n.cover ? (
        <Figure
          {...n.cover}
          caption={undefined}
          cover
          sizes="(max-width: 42rem) calc(100vw - 44px), (max-width: 70rem) 50vw, 33vw"
        />
      ) : (
        <div class="note-cover-placeholder" aria-hidden="true" />
      )
    }
  </div>
  <span class="note-date">
    <time datetime={n.date}>{period.start}</time>
    {
      period.end && n.endDate && (
        <>
          {" — "}
          <time datetime={n.endDate}>{period.end}</time>
        </>
      )
    }
  </span>
  <h2 id={`note-${n.id}`}>{n.title}</h2>
  <p>{n.summary}</p>
  <ul class="tags" aria-label={n.title}>
    {n.tags.map((tag) => <li>{tag}</li>)}
  </ul>
</a>
